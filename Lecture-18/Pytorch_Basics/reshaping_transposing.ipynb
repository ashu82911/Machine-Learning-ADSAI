    " [5, 6, 7, 8],\n",
    " [9, 10, 11, 12]])\n",
    "# Reshaping\n",
    "print(\"Reshaping\")\n",
    "print(t.reshape(6, 2))\n",
    "# Resizing (deprecated, use reshape)\n",
